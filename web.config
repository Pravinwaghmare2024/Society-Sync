<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <staticContent>
            <!-- Remove existing mappings to avoid duplicates -->
            <remove fileExtension=".tsx" />
            <remove fileExtension=".ts" />
            <!-- Map TSX and TS to Javascript for Babel Standalone to process -->
            <mimeMap fileExtension=".tsx" mimeType="application/javascript" />
            <mimeMap fileExtension=".ts" mimeType="application/javascript" />
        </staticContent>
        <security>
            <requestFiltering>
                <fileExtensions>
                    <!-- Ensure .tsx isn't hidden by default IIS security rules -->
                    <add fileExtension=".tsx" allowed="true" />
                </fileExtensions>
            </requestFiltering>
        </security>
        <defaultDocument>
            <files>
                <add value="index.html" />
            </files>
        </defaultDocument>
        <directoryBrowse enabled="false" />
    </system.webServer>
</configuration>